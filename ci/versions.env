# bst pinned upstream sources.
#
# Single source of truth for "which version + which tarball + which checksum".
# Consumed by scripts/lib/common.sh (bst_fetch). The build scripts verify every
# download against the recorded sha256 and fail closed on mismatch.
#
# Format: <lib>|<version>|<url>|<sha256>
# To add a new upstream version, run: scripts/pin.sh <lib> <version>
# (downloads the official tarball, computes the sha256, appends the row here).
#
# Default version per library (override with --version <v>):
OPENSSL_DEFAULT_VERSION=3.5.9
JEMALLOC_DEFAULT_VERSION=5.4.0
LIBURING_DEFAULT_VERSION=2.15

# --- source table -----------------------------------------------------------
# openssl 3.5.x is the current LTS line; 4.0.x is the current stable feature
# line. https://github.com/openssl/openssl/releases (sha256 of the official
# openssl-<ver>.tar.gz release asset, cross-checked against the published
# .sha256 asset).
openssl|3.5.9|https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz|603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
openssl|4.0.3|https://github.com/openssl/openssl/releases/download/openssl-4.0.3/openssl-4.0.3.tar.gz|325b5c806167c13b40b1ffeadfe0248197c00eccc4cf123ec1e28d2d2fd216d9

# jemalloc 5.4.0 (current stable). sha256 of the GitHub release asset
# jemalloc-5.4.0.tar.bz2 (matches the GitHub release digest).
jemalloc|5.4.0|https://github.com/jemalloc/jemalloc/releases/download/5.4.0/jemalloc-5.4.0.tar.bz2|200776fac271093e7c2f21edd6d62657ecd2be578d9328633f2a86bfa6ef4f1d

# liburing 2.15 (current stable; Linux-only library). GitHub publishes no
# release assets, so the tag tarball is pinned by its computed sha256.
liburing|2.15|https://github.com/axboe/liburing/archive/refs/tags/liburing-2.15.tar.gz|8d052f2622dcb3678cbaee5ff582a87572672a6c0a56533cdda5b65cb636120a
