# bst site matrix -- machine-readable single source for the supported
# build sites.  Consumed by scripts/lib/common.sh (site_info) and
# cross-checked by ci/check-workflows.sh against .github/workflows/*.yml.
#
# Format: site|triple|family|cc|cxx|cross_prefix|emulator|libs
#   site          bst site key used on the command line (--site)
#   triple        GNU target triple (also the dist/ artifact directory name)
#   family        linux | linux-clang | windows | macos | android
#   cc / cxx      optional compiler override for the family default
#   cross_prefix  toolchain prefix for cross sites, e.g. aarch64-linux-gnu-
#                 (empty = host compiler)
#   emulator      qemu-user emulator used to run the smoke test (empty = run
#                 natively; i686-native = run the 32-bit binaries directly)
#   libs          space-separated libraries that support this site
#
# Host/target policy: Windows hosts build Windows sites; Linux hosts build
# Linux + Android sites; macOS hosts build macOS sites.  A site whose family
# does not match the host is refused with a clear message (Windows hosts may
# delegate Linux/Android sites through WSL via scripts/build.ps1).
#
# --- Linux (cross builds verified under qemu-user) --------------------------
linux-x86_64|x86_64-unknown-linux-gnu|linux|||||openssl jemalloc liburing
linux-x86_64-clang|x86_64-unknown-linux-gnu|linux|clang|clang++|||openssl jemalloc liburing
linux-aarch64|aarch64-unknown-linux-gnu|linux|||aarch64-linux-gnu-|qemu-aarch64|openssl jemalloc liburing
linux-armv7|arm-linux-gnueabihf|linux|||arm-linux-gnueabihf-|qemu-arm|openssl jemalloc liburing
linux-riscv64|riscv64-unknown-linux-gnu|linux|||riscv64-linux-gnu-|qemu-riscv64|openssl jemalloc liburing
linux-ppc64le|powerpc64le-unknown-linux-gnu|linux|||powerpc64le-linux-gnu-|qemu-ppc64le|openssl jemalloc liburing
linux-s390x|s390x-unknown-linux-gnu|linux|||s390x-linux-gnu-|qemu-s390x|openssl jemalloc liburing
linux-i686|i686-unknown-linux-gnu|linux|||i686-linux-gnu-|i686-native|openssl jemalloc liburing
# --- Windows MSVC -----------------------------------------------------------
# jemalloc's official MSVC project files (msvc/jemalloc_vc2022.sln) ship only
# Win32/x64 configurations, so windows-msvc-arm64 currently ships openssl
# only; requesting jemalloc for it fails closed with an explicit message.
windows-msvc-x64|x86_64-pc-windows-msvc|windows|||||openssl jemalloc
windows-msvc-x86|i686-pc-windows-msvc|windows|||||openssl jemalloc
windows-msvc-arm64|aarch64-pc-windows-msvc|windows|||||openssl
# --- macOS (Apple Silicon first, Intel supported) ---------------------------
macos-arm64|arm64-apple-darwin|macos|||||openssl jemalloc
macos-x64|x86_64-apple-darwin|macos|||||openssl jemalloc
# --- Android (NDK; compile + link only, no device runner) -------------------
android-arm64-v8a|aarch64-linux-android|android|||||openssl jemalloc
android-armeabi-v7a|armv7a-linux-androideabi|android|||||openssl jemalloc
android-x86_64|x86_64-linux-android|android|||||openssl jemalloc
android-x86|i686-linux-android|android|||||openssl jemalloc
